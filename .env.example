# aws-local-lab :: environment knobs
# Copy to .env (gitignored) and adjust. Every value below has a working default;
# the no-token path needs no edits at all.

# --- LocalStack auth token (OPTIONAL, PAID) ---------------------------------
# Leave blank. The default image (localstack/localstack:4.14.0) needs no token
# and runs the full community service set (~30 services: S3, DynamoDB, Lambda,
# SQS/SNS, EventBridge, Step Functions, API Gateway REST v1, CloudFormation, ...).
# A free "Hobby" token unlocks NOTHING beyond this. Only a PAID token (Base
# $39-45/mo and up) unlocks the Pro set - ELBv2/ALB, ECS/ECR/EKS, EC2 & App
# Auto Scaling, RDS/Aurora, ElastiCache, Cognito, API Gateway v2 - and only
# together with LOCALSTACK_IMAGE=localstack/localstack:latest below.
# See docs/fidelity-matrix.md for exactly what each tier covers.
LOCALSTACK_AUTH_TOKEN=

# --- AWS client credentials --------------------------------------------------
# LocalStack accepts any non-empty creds. bin/awslocal defaults these too.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- Image override ---------------------------------------------------------
# Blank = default localstack/localstack:4.14.0 (last tokenless release, community
# service set). Set to localstack/localstack:latest ONLY if you have a PAID
# LOCALSTACK_AUTH_TOKEN and need Pro services; 2026.x images exit code 55
# without a valid token. `make up NO_TOKEN=1` layers docker-compose.no-token.yml
# (same 4.14.0 pin, token forced blank).
LOCALSTACK_IMAGE=

# --- Persistence ----------------------------------------------------------
# 0 (default) = fresh state each boot. `make reset` always wipes.
# 1 = persist state across restarts - but this is a PAID (Base/Ultimate)
# feature. On the community image PERSISTENCE=1 writes nothing on shutdown, so
# regression baselines use code-as-baseline (`make reset` + re-apply Terraform +
# `make lab-seed`). See integration/README.md and docs/fidelity-matrix.md.
PERSISTENCE=0

# --- Service narrowing -----------------------------------------------------
# Blank = eager-load all community services. Comma list narrows for faster boot,
# e.g. SERVICES=s3,dynamodb,lambda,sqs
SERVICES=

# --- Edge port ----------------------------------------------------------
# Host port mapped to the LocalStack edge. Change only if 4566 is already taken.
EDGE_PORT=4566

# --- Debug --------------------------------------------------------------
# 1 = verbose LocalStack logs.
DEBUG=0
