# aws-local-lab :: environment knobs
# Copy to .env (gitignored) and adjust. Every value below has a working default;
# the no-token path needs no edits at all.

# --- LocalStack free-tier auth token -----------------------------------------
# Get one (free) at https://app.localstack.cloud -> Auth Tokens.
# Leave blank to run the no-token community image (see LOCALSTACK_IMAGE / `make up NO_TOKEN=1`).
LOCALSTACK_AUTH_TOKEN=

# --- AWS client credentials --------------------------------------------------
# LocalStack accepts any non-empty creds. bin/awslocal defaults these too.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- Image override ---------------------------------------------------------
# Blank = token-mode default (localstack/localstack:4.9.0).
# Set to localstack/localstack:3.8.1 for the pinned no-token community image
# (or just use `make up NO_TOKEN=1`, which layers docker-compose.no-token.yml).
LOCALSTACK_IMAGE=

# --- Persistence ----------------------------------------------------------
# 1 = state survives `make restart` / `make down` + `up` (kept in the named volume).
# 0 (default) = fresh state each boot. `make reset` always wipes.
PERSISTENCE=0

# --- Service narrowing -----------------------------------------------------
# Blank = eager-load all community services. Comma list narrows for faster boot,
# e.g. SERVICES=s3,dynamodb,lambda,sqs
SERVICES=

# --- Edge port ----------------------------------------------------------
# Host port mapped to the LocalStack edge. Change only if 4566 is already taken.
EDGE_PORT=4566

# --- Debug --------------------------------------------------------------
# 1 = verbose LocalStack logs.
DEBUG=0
